{
  "name": "pycraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PYCRAFT — Code Your World. A local-first 3D voxel adventure game where real Python code brings Aetheria back to life.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "palette:lint": "tsx scripts/lint-palette.ts",
    "content:check": "tsx scripts/validate-content.ts",
    "bake:world": "tsx scripts/bake-world.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "codemirror": "^6.0.1",
    "idb": "^8.0.2",
    "pyodide": "^0.27.5",
    "react": ">=19.0.0 <19.4.0",
    "react-dom": ">=19.0.0 <19.4.0",
    "three": "^0.174.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.9"
  }
}
